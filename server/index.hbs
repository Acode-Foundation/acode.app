<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  {{#if homePoster}}
  <link rel="preload" as="image" imagesrcset="{{homePoster}}" imagesizes="(max-width: 1168px) calc(100vw - 48px), 1120px" fetchpriority="high" />
  {{/if}}
  {{#if preload_image}}
  <link rel="preload" as="image" href="{{preload_image}}" fetchpriority="high" />
  {{/if}}

  <script defer src="/main.min.js"></script>
  <link rel="stylesheet" href="/main.css" />
  <link rel="shortcut icon" href="/favicon.ico" type="image/x-icon" />
  <link rel="icon" href="/favicon.ico" type="image/x-icon" />
  <link rel="icon" href="/favicon-16x16.png" type="image/png" />
  <link rel="manifest" href="/manifest.json" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" type="image/png" />
  <meta name="theme-color" content="#101421" />
  <title>{{title}}</title>

  <!-- Primary meta tags -->
  <meta name="title" content="{{title}}" />
  <meta name="description" content="{{description}}" />
  <meta name="robots" content="{{robots}}" />

  <!-- Canonical URL -->
  <link rel="canonical" href="{{canonical_url}}" />

  <!-- Open Graph meta tags -->
  <meta property="og:title" content="{{title}}" />
  <meta property="og:description" content="{{description}}" />
  <meta property="og:image" content="{{image_url}}" />
  <meta property="og:image:secure_url" content="{{image_url}}" />
  <meta property="og:image:type" content="{{image_type}}" />
  <meta property="og:image:width" content="{{image_width}}" />
  <meta property="og:image:height" content="{{image_height}}" />
  <meta property="og:image:alt" content="{{image_alt}}" />
  <meta property="og:url" content="{{canonical_url}}" />
  <meta property="og:type" content="{{og_type}}" />
  <meta property="og:site_name" content="{{site_name}}" />
  <meta property="og:locale" content="en_US" />

  <!-- Twitter Card meta tags -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:site" content="@foxbiz_io" />
  <meta name="twitter:title" content="{{title}}" />
  <meta name="twitter:description" content="{{description}}" />
  <meta name="twitter:image" content="{{image_url}}" />
  <meta name="twitter:image:alt" content="{{image_alt}}" />

  {{#if pageSchema}}
  <!-- Structured data (JSON-LD) -->
  <script type="application/ld+json">{{{pageSchema}}}</script>
  {{/if}}
  {{#if orgSchema}}
  <script type="application/ld+json">{{{orgSchema}}}</script>
  {{/if}}

  <link rel="stylesheet" href="/consent.css" />
  <script defer src="/consent.min.js" data-ads-disabled="{{#if adsDisabled}}true{{else}}false{{/if}}"></script>

</head>

<body>
  {{#unless detail}}<noscript>Please enable javascript to view this page.</noscript>{{/unless}}
  <div id="app">{{#with detail}}
    <article class="public-detail">
      {{#if parentPath}}<a href="{{parentPath}}">{{parentLabel}}</a>{{/if}}
      <h1>{{heading}}</h1>
      {{#if author}}<p>By {{author}}</p>{{/if}}
      {{#if version}}<p>Version {{version}}</p>{{/if}}
      {{#if platform}}<p>{{platform}}</p>{{/if}}
      <p class="detail-text">{{text}}</p>
      {{#if links}}<ul>{{#each links}}<li><a href="{{href}}">{{label}}</a></li>{{/each}}</ul>{{/if}}
    </article>
  {{/with}}</div>
</body>

</html>
