SALT=
PORT=3031
HOST=https://dev.acode.app
# Production: https://go.acode.app
PROMOTION_TRACKING_ORIGIN=https://go.dev.acode.app
NODE_ENV=development
ADMIN_NAME=John Doe
ADMIN_EMAIL=john@example.com
ADMIN_PASSWORD=
ADMIN_GITHUB=john-doe
ADMIN_WEBSITE="https://example.com"

EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USERNAME=email-user
EMAIL_PASSWORD=

PG_KEY_ID=
PG_KEY_SECRET=
PG_WEBHOOK_SECRET=

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=https://dev.acode.app/oauth/github/callback

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://dev.acode.app/oauth/google/callback

# Sign in with Apple: associate the Services ID with your primary App ID and
# register the website domain and exact HTTPS return URL in Apple Developer.
# Register outbound email senders with Apple's private email relay for OTP delivery.
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
# Paste the complete .p8 PEM with its original line breaks.
APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----
PASTE_YOUR_P8_KEY_CONTENT_HERE
-----END PRIVATE KEY-----"
APPLE_CALLBACK_URL=https://dev.acode.app/oauth/apple/callback
# Dedicated, persistent 32-byte key as 64 hex characters. Keep backed up for revocation.
TOKEN_ENCRYPTION_KEY=

EXCHANGERATE_API=

BUCKET_SECRET=
BUCKET_REGION=
BUCKET_NAME=
BUCKET_KEY=
BUCKET_ENDPOINT=

# Plugin security scanner (https://github.com/Acode-Foundation/plugin_scanner).
# Defaults to `plugin_scanner` on PATH. If it can't run, plugin updates are held for review.
PLUGIN_SCANNER_BIN=/usr/local/bin/plugin_scanner
